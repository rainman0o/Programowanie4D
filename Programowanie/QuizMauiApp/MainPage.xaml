<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizMauiApp.MainPage"
             xmlns:local="clr-namespace:QuizMauiApp"
             BackgroundColor="AliceBlue">

    <ContentPage.BindingContext>
        <local:MainViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Frame BackgroundColor="White">
                <Frame BackgroundColor="MediumPurple" MaximumWidthRequest="800" CornerRadius="10">
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label Text="Pytanie "
                               FontSize="22"
                               TextColor="White"/>
                        <Label Text="{Binding CurrentQuestion.Id}"
                               FontSize="22"
                               TextColor="White"/>
                    </HorizontalStackLayout>
                </Frame>
            </Frame>


            <Frame BackgroundColor="White">
                <Frame BackgroundColor="Blue" MaximumWidthRequest="400" CornerRadius="10">
                    <Label Text="{Binding CurrentQuestion.QuestionText}"
                           FontSize="22"
                           TextColor="white"
                           HorizontalOptions="Center"/>
                </Frame>
            </Frame>

            <Frame BackgroundColor="White">

                <StackLayout BindableLayout.ItemsSource="{Binding CurrentAnswers}"
                             RadioButtonGroup.GroupName="answers"
                             RadioButtonGroup.SelectedValue="{Binding SelectedAnswer}"
                             IsEnabled="{Binding EnableOrDisableAnswers}"
                             >

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="LightBlue" Margin="10" CornerRadius="10" MaximumWidthRequest="400">
                                <HorizontalStackLayout >
                                    <RadioButton Value="{Binding .}" />
                                    <Label Text="{Binding AnswerText}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{Binding Color}"/>
                                </HorizontalStackLayout>

                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

            </Frame>

            <Frame BackgroundColor="White">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="Sprawdź"
                            Command="{Binding CheckAnswer}"
                            BackgroundColor="DeepSkyBlue"
                            FontSize="18"
                            TextColor="White"
                            CornerRadius="10"/>
                    <Button Text="Następne"
                            Command="{Binding NextQuestion}"
                            BackgroundColor="DeepSkyBlue"
                            FontSize="18"
                            TextColor="White"
                            CornerRadius="10"/>
                </HorizontalStackLayout>
            </Frame>



            <Frame BackgroundColor="White">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                    <Frame BackgroundColor="LightGreen" CornerRadius="10">
                        <StackLayout HorizontalOptions="Start" MaximumWidthRequest="200">
                            <Label Text="Poprawne odpowiedzi: "
                               FontSize="16"
                               TextColor="white"/>
                            <Label Text="{Binding AmmountOfGoodAnswers}"
                               FontSize="12"
                               TextColor="White"
                                HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="OrangeRed" CornerRadius="10" MaximumWidthRequest="200" HorizontalOptions="End" IsVisible="{Binding NotificationIsSet}">
                        <Label Text="{Binding Notification}"
                               TextColor="White"
                               FontSize="16"
                               VerticalTextAlignment="Center"/>
                    </Frame>
                </HorizontalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>